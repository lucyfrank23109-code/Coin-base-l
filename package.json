{
  "name": "coin-base",
  "version": "1.0.0",
  "description": "Professional cryptocurrency and financial wallet portfolio application",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "nodemon --exec node --experimental-modules server/index.js",
    "client:dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "db:migrate": "node server/migrations/run.js",
    "db:seed": "node server/seeders/seed.js",
    "lint": "eslint .",
    "test": "jest"
  },
  "keywords": [
    "crypto",
    "wallet",
    "portfolio",
    "financial",
    "bitcoin",
    "ethereum"
  ],
  "author": "lucyfrank23109-code",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "pg": "^8.11.2",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.1.0",
    "axios": "^1.6.0",
    "uuid": "^9.0.1",
    "joi": "^17.11.0",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.5",
    "morgan": "^1.10.0",
    "qrcode": "^1.5.3",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "vite": "^5.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "nodemon": "^3.0.1",
    "concurrently": "^8.2.2",
    "eslint": "^8.54.0",
    "jest": "^29.7.0"
  }
}
